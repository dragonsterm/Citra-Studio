[
  { "id": "tone", "name": "Tone & pixels", "icon": "sliders", "methods": [
    {"id":"grayscale","name":"Grayscale","formula":"Y = 0.299R + 0.587G + 0.114B","description":"Collapse RGB into one intensity channel.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Luminance","options":["Luminance","Average"]}]},
    {"id":"threshold","name":"Thresholding","formula":"g = 255 if Y > T, otherwise 0","description":"Split the image into foreground and background.","params":[{"key":"threshold","label":"Threshold","type":"range","default":128,"min":0,"max":255,"step":1}]},
    {"id":"double","name":"Double threshold","formula":"g = 255 if T₁ ≤ Y ≤ T₂, otherwise 0","description":"Keep pixels inside the selected intensity interval.","params":[{"key":"low","label":"Lower bound","type":"range","default":70,"min":0,"max":255,"step":1},{"key":"high","label":"Upper bound","type":"range","default":170,"min":0,"max":255,"step":1}]},
    {"id":"negative","name":"Negative","formula":"g = 255 − f","description":"Invert each RGB channel.","params":[]},
    {"id":"brightness","name":"Brightness","formula":"g = clip(f + β)","description":"Shift intensities by a constant.","params":[{"key":"amount","label":"Offset","type":"range","default":35,"min":-150,"max":150,"step":1}]},
    {"id":"contrast","name":"Contrast","formula":"g = clip(α(f − 128) + 128)","description":"Adjust contrast around the midpoint or stretch the occupied range.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Gain","options":["Gain","Stretch"]},{"key":"gain","label":"Gain","type":"range","default":1.5,"min":0.1,"max":3,"step":0.05,"when":{"key":"variant","values":["Gain"]}}]},
    {"id":"tone","name":"Intensity transform","formula":"g = T(f)","description":"Apply a power, root, logarithmic or piecewise curve.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Gamma","options":["Gamma","Root","Log","Inverse log","Gray-level slicing","Bit-plane slicing"]},{"key":"gamma","label":"Gamma","type":"range","default":0.55,"min":0.1,"max":4,"step":0.05,"when":{"key":"variant","values":["Gamma"]}},{"key":"low","label":"Slice minimum","type":"range","default":75,"min":0,"max":255,"step":1,"when":{"key":"variant","values":["Gray-level slicing"]}},{"key":"high","label":"Slice maximum","type":"range","default":165,"min":0,"max":255,"step":1,"when":{"key":"variant","values":["Gray-level slicing"]}},{"key":"bit","label":"Bit plane","type":"range","default":7,"min":0,"max":7,"step":1,"when":{"key":"variant","values":["Bit-plane slicing"]}}]},
    {"id":"quantize","name":"Intensity quantization","formula":"g = round(Y(L − 1)/255) × 255/(L − 1)","description":"Reduce intensity levels with uniform or logarithmic mapping.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Uniform","options":["Uniform","Logarithmic"]},{"key":"levels","label":"Levels","type":"range","default":4,"min":2,"max":64,"step":1}]},
    {"id":"arithmetic","name":"Image arithmetic","formula":"g = clip(A op B)","description":"Use a scalar or a reference image resized to match the source.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Add","options":["Add","Subtract","Multiply","Divide"]},{"key":"operand","label":"Operand","type":"select","default":"Scalar","options":["Scalar","Reference photo"]},{"key":"value","label":"Scalar","type":"range","default":40,"min":1,"max":255,"step":1,"when":{"key":"operand","values":["Scalar"]}}]},
    {"id":"boolean","name":"Boolean operations","formula":"g = A op B","description":"Run bitwise logic on binary masks.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"NOT","options":["NOT","AND","OR","XOR"]},{"key":"threshold","label":"Threshold","type":"range","default":128,"min":0,"max":255,"step":1}]},
    {"id":"equalize","name":"Equalization","formula":"g = T(Y), where T is the cumulative histogram","description":"Improve contrast using global equalization or local CLAHE.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Global","options":["Global","CLAHE"]},{"key":"output","label":"Output","type":"select","default":"Color","options":["Color","Grayscale"]}]},
    {"id":"matching","name":"Histogram specification","formula":"g = CDF_target⁻¹(CDF_source(Y))","description":"Remap luminance to a target distribution or reference photo.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Bell curve","options":["Bell curve","Reference photo"]}]}
  ] },
  { "id": "spatial", "name": "Spatial filters", "icon": "layers", "methods": [
    {"id":"blur","name":"Blur & smoothing","formula":"g = K ∗ f","description":"Choose a neighborhood averaging or edge-preserving filter.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Gaussian","options":["Gaussian","Mean","Weighted mean","Median","Minimum","Maximum","Bilateral","Motion"]},{"key":"size","label":"Kernel size","type":"range","default":5,"min":3,"max":31,"step":2},{"key":"angle","label":"Motion angle (°)","type":"range","default":0,"min":-180,"max":180,"step":1,"when":{"key":"variant","values":["Motion"]}}]},
    {"id":"sharpen","name":"Sharpening","formula":"g = f + k(f − LPF(f))","description":"Enhance detail with a cross kernel, unsharp masking or high-boost filtering.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Laplacian kernel","options":["Laplacian kernel","Unsharp mask","High boost"]},{"key":"amount","label":"Amount","type":"range","default":1,"min":0,"max":3,"step":0.05},{"key":"size","label":"Kernel size","type":"range","default":5,"min":3,"max":31,"step":2,"when":{"key":"variant","values":["Unsharp mask","High boost"]}}]},
    {"id":"convolution","name":"Convolution","formula":"g(x,y) = Σᵢⱼ K(i,j) f(x−i,y−j)","description":"Apply a preset or enter nine kernel values separated by spaces.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Identity","options":["Identity","Low-pass","High-pass","Custom"]},{"key":"kernel","label":"Custom 3 × 3 kernel","type":"text","default":"0 -1 0 -1 5 -1 0 -1 0","maxLength":96,"when":{"key":"variant","values":["Custom"]}},{"key":"divisor","label":"Divisor","type":"range","default":1,"min":1,"max":32,"step":1}]},
    {"id":"emboss","name":"Emboss","formula":"g = clip(K ∗ Y + 128)","description":"Give light and shadow to edges using a directional kernel.","params":[]},
    {"id":"sketch","name":"Sketch","formula":"g = clip(255Y / max(255 − G(255 − Y), 1))","description":"Simulate pencil shading with Gaussian blur and color dodge.","params":[{"key":"size","label":"Kernel size","type":"range","default":15,"min":3,"max":41,"step":2}]},
    {"id":"cnn","name":"CNN feature map","formula":"g = pool(max(0, K ⋆ Y))","description":"Inspect convolution, ReLU and pooling with fixed educational kernels.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Max pooling","options":["Convolution + ReLU","Max pooling","Average pooling"]},{"key":"kernel","label":"Feature","type":"select","default":"Vertical edge","options":["Vertical edge","Horizontal edge","Detail"]},{"key":"size","label":"Pooling window","type":"range","default":2,"min":2,"max":4,"step":1,"when":{"key":"variant","values":["Max pooling","Average pooling"]}}]},
    {"id":"classify","name":"CNN classification","formula":"p(class | image) = softmax(logits)","description":"Classify the image using a pretrained MobileNetV2 and inspect the top three predictions.","params":[{"key":"variant","label":"Display","type":"select","default":"Label overlay","options":["Label overlay","Original image"]}]}
  ] },
  { "id": "geometry", "name": "Geometry", "icon": "move", "methods": [
    {"id":"mirror","name":"Mirroring","formula":"g(x,y) = f(W−1−x,y) for a horizontal flip","description":"Reflect the source along one or both axes.","params":[{"key":"axis","label":"Axis","type":"select","default":"Horizontal","options":["Horizontal","Vertical","Both"]}]},
    {"id":"rotate","name":"Rotation","formula":"g = warpAffine(f, Rθ)","description":"Rotate around the center and fit the whole rotated image.","params":[{"key":"angle","label":"Angle (°)","type":"range","default":25,"min":-180,"max":180,"step":1},{"key":"interpolation","label":"Interpolation","type":"select","default":"Bilinear","options":["Nearest","Bilinear","Bicubic"]}]},
    {"id":"translate","name":"Translation","formula":"g(x,y) = f(x−Δx,y−Δy)","description":"Move the image inside its original bounds.","params":[{"key":"x","label":"Horizontal (%)","type":"range","default":15,"min":-80,"max":80,"step":1},{"key":"y","label":"Vertical (%)","type":"range","default":10,"min":-80,"max":80,"step":1},{"key":"interpolation","label":"Interpolation","type":"select","default":"Bilinear","options":["Nearest","Bilinear","Bicubic"]}]},
    {"id":"scale","name":"Sampling & scaling","formula":"g(x,y) = f(x/s,y/s)","description":"Compare sampling and interpolation at different resolutions.","params":[{"key":"scale","label":"Scale (%)","type":"range","default":45,"min":10,"max":200,"step":5},{"key":"interpolation","label":"Interpolation","type":"select","default":"Bilinear","options":["Nearest","Bilinear","Bicubic"]}]},
    {"id":"crop","name":"Crop","formula":"g = f[y₀:y₁, x₀:x₁]","description":"Select a rectangular region using percent coordinates.","params":[{"key":"x","label":"Left (%)","type":"range","default":15,"min":0,"max":95,"step":1},{"key":"y","label":"Top (%)","type":"range","default":15,"min":0,"max":95,"step":1},{"key":"width","label":"Width (%)","type":"range","default":70,"min":5,"max":100,"step":1},{"key":"height","label":"Height (%)","type":"range","default":70,"min":5,"max":100,"step":1}]},
    {"id":"warp","name":"Geometric correction","formula":"g = warpPerspective(f, H)","description":"Apply shear, perspective correction or radial lens correction.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Perspective","options":["Perspective","Shear","Lens"]},{"key":"amount","label":"Strength","type":"range","default":0.2,"min":-0.45,"max":0.45,"step":0.01},{"key":"interpolation","label":"Interpolation","type":"select","default":"Bilinear","options":["Nearest","Bilinear","Bicubic"]}],"workingLimit":1800}
  ] },
  { "id": "color", "name": "Color spaces", "icon": "palette", "methods": [
    {"id":"channel","name":"Color conversion","formula":"RGB → selected color model → selected component","description":"View individual channels as intensities or reconstruct RGB after conversion.","params":[{"key":"space","label":"Color model","type":"select","default":"HSV","options":["RGB","HSV","HSI","HSL","CMY","CMYK","XYZ","YIQ","YUV","YCbCr","Lab"]},{"key":"component","label":"Display","type":"select","default":"1","options":["1","2","3","4","RGB round-trip"]}],"workingLimit":2500},
    {"id":"hsv","name":"HSV adjustment","formula":"HSV → (H + ΔH, S × k, V × gain) → RGB","description":"Modify hue, saturation and value independently.","params":[{"key":"hue","label":"Hue shift (°)","type":"range","default":45,"min":-180,"max":180,"step":1},{"key":"sat","label":"Saturation","type":"range","default":1.15,"min":0,"max":2,"step":0.05},{"key":"value","label":"Value gain","type":"range","default":1,"min":0,"max":2,"step":0.05}]},
    {"id":"pseudocolor","name":"Pseudo-color","formula":"g(x,y) = palette[Y(x,y)]","description":"Map gray intensities to colors.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Turbo","options":["Turbo","Viridis","Inferno","Jet","Intensity slices"]}]}
  ] },
  { "id": "edges", "name": "Edge detection", "icon": "scan", "methods": [
    {"id":"edge","name":"Edge detection","formula":"∇f = (Gx,Gy), M = √(Gx² + Gy²)","description":"Compare first- and second-derivative operators with Canny and the report kernel.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Sobel","options":["Forward gradient","Central gradient","Sobel","Prewitt","Roberts","Laplacian","LoG","Difference of Gaussians","Zero crossing","Canny","Report kernel"]},{"key":"direction","label":"Display","type":"select","default":"Magnitude","options":["Magnitude","X gradient","Y gradient"],"when":{"key":"variant","values":["Forward gradient","Central gradient","Sobel","Prewitt","Roberts"]}},{"key":"low","label":"Canny low","type":"range","default":55,"min":0,"max":254,"step":1,"when":{"key":"variant","values":["Canny"]}},{"key":"high","label":"Canny high","type":"range","default":135,"min":1,"max":255,"step":1,"when":{"key":"variant","values":["Canny"]}}]},
    {"id":"hough","name":"Hough transform","formula":"ρ = x cos θ + y sin θ","description":"Find lines or circles using votes from edge pixels.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Lines","options":["Lines","Circles"]},{"key":"votes","label":"Vote threshold","type":"range","default":40,"min":10,"max":160,"step":1}],"workingLimit":1000},
    {"id":"contours","name":"Contour tracing","formula":"boundary = connected foreground border","description":"Trace and count the contours of a binary image.","params":[{"key":"threshold","label":"Threshold","type":"range","default":128,"min":0,"max":255,"step":1},{"key":"area","label":"Minimum area (%)","type":"range","default":0.2,"min":0,"max":10,"step":0.1}]},
    {"id":"corners","name":"Corner detection","formula":"R = det(M) − k(trace M)²","description":"Detect Harris or Shi–Tomasi corner points for geometric matching.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Harris","options":["Harris","Shi–Tomasi"]},{"key":"quality","label":"Minimum quality","type":"range","default":0.03,"min":0.01,"max":0.25,"step":0.01}],"workingLimit":1600}
  ] },
  { "id": "frequency", "name": "Frequency domain", "icon": "wave", "methods": [
    {"id":"spectrum","name":"Fourier spectrum","formula":"S = log(1 + |fftshift(DFT(Y))|)","description":"Inspect the amplitude or phase of the 2D Fourier transform.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Magnitude","options":["Magnitude","Phase","Inverse reconstruction"]}],"workingLimit":1600},
    {"id":"dct","name":"Cosine transform","formula":"C = DCT₂(Y)","description":"Inspect frequency coefficients or reconstruct with only low frequencies.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Coefficients","options":["Coefficients","Reconstruction"]},{"key":"keep","label":"Low frequencies (%)","type":"range","default":18,"min":1,"max":100,"step":1,"when":{"key":"variant","values":["Reconstruction"]}}],"workingLimit":1600},
    {"id":"frequency","name":"Frequency filter","formula":"g = IDFT(H · DFT(Y))","description":"Choose ideal, Gaussian or Butterworth low-, high- or band filtering.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Gaussian","options":["Ideal","Gaussian","Butterworth"]},{"key":"pass","label":"Passband","type":"select","default":"Low-pass","options":["Low-pass","High-pass","Band-pass","Band-reject"]},{"key":"cutoff","label":"Cutoff (% Nyquist)","type":"range","default":16,"min":1,"max":100,"step":1},{"key":"band","label":"Band width (%)","type":"range","default":10,"min":1,"max":50,"step":1,"when":{"key":"pass","values":["Band-pass","Band-reject"]}},{"key":"order","label":"Butterworth order","type":"range","default":2,"min":1,"max":6,"step":1,"when":{"key":"variant","values":["Butterworth"]}}],"workingLimit":1400},
    {"id":"notch","name":"Notch filter","formula":"H = 1 − mask(±u₀, ±v₀)","description":"Reject or pass a symmetric pair of frequency neighborhoods.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Reject","options":["Reject","Pass"]},{"key":"x","label":"Frequency X (cycles)","type":"range","default":18,"min":-80,"max":80,"step":1},{"key":"y","label":"Frequency Y (cycles)","type":"range","default":0,"min":-80,"max":80,"step":1},{"key":"width","label":"Notch radius","type":"range","default":4,"min":1,"max":24,"step":1}],"workingLimit":1400}
  ] },
  { "id": "restore", "name": "Noise & restoration", "icon": "activity", "methods": [
    {"id":"noise","name":"Noise","formula":"g = clip(f + n) or impulse replacement","description":"Add repeatable noise to test restoration filters.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Gaussian","options":["Gaussian","Salt and pepper","Salt","Pepper","Uniform","Rayleigh","Exponential","Erlang","Periodic","Speckle","Poisson"]},{"key":"amount","label":"Strength (%)","type":"range","default":15,"min":1,"max":65,"step":1},{"key":"seed","label":"Random seed","type":"range","default":7,"min":0,"max":100,"step":1}],"workingLimit":1800},
    {"id":"denoise","name":"Noise reduction","formula":"g = T(neighborhood)","description":"Restore using order statistics, mean variants or adaptive local noise reduction.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Median","options":["Arithmetic mean","Geometric mean","Harmonic mean","Contraharmonic mean","Median","Minimum","Maximum","Midpoint","Alpha-trimmed mean","Adaptive local mean","Adaptive median"]},{"key":"size","label":"Kernel size","type":"range","default":5,"min":3,"max":11,"step":2},{"key":"order","label":"Contraharmonic Q","type":"range","default":1.5,"min":-3,"max":3,"step":0.1,"when":{"key":"variant","values":["Contraharmonic mean"]}},{"key":"variance","label":"Noise variance","type":"range","default":200,"min":10,"max":1600,"step":1,"when":{"key":"variant","values":["Adaptive local mean"]}}],"workingLimit":1200},
    {"id":"deblur","name":"Deblur","formula":"Wiener: F̂ = H*G / (|H|² + K)","description":"Estimate a sharper image using a Gaussian or motion point spread function.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Wiener","options":["Wiener","Inverse filtering","Richardson–Lucy"]},{"key":"psf","label":"Blur model","type":"select","default":"Motion","options":["Motion","Gaussian"]},{"key":"size","label":"Kernel size","type":"range","default":9,"min":3,"max":31,"step":2},{"key":"angle","label":"Motion angle (°)","type":"range","default":0,"min":-180,"max":180,"step":1,"when":{"key":"psf","values":["Motion"]}},{"key":"regularizer","label":"Regularization","type":"range","default":0.025,"min":0.001,"max":0.15,"step":0.001,"when":{"key":"variant","values":["Wiener","Inverse filtering"]}},{"key":"iterations","label":"Lucy iterations","type":"range","default":6,"min":1,"max":15,"step":1,"when":{"key":"variant","values":["Richardson–Lucy"]}}],"workingLimit":1200}
  ] },
  { "id": "regions", "name": "Segmentation", "icon": "grid", "methods": [
    {"id":"auto_threshold","name":"Automatic threshold","formula":"Otsu: T = argmax between-class variance","description":"Segment by Otsu, multi-Otsu, iterative selection or adaptive thresholds.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Otsu","options":["Otsu","Multi-Otsu","Iterative","Adaptive mean","Adaptive Gaussian"]},{"key":"size","label":"Kernel size","type":"range","default":15,"min":3,"max":41,"step":2,"when":{"key":"variant","values":["Adaptive mean","Adaptive Gaussian"]}},{"key":"offset","label":"Adaptive offset","type":"range","default":4,"min":-30,"max":30,"step":1,"when":{"key":"variant","values":["Adaptive mean","Adaptive Gaussian"]}}]},
    {"id":"region","name":"Region growing","formula":"R = connected region of pixels within the intensity tolerance","description":"Grow from a selected seed or scan for similar connected regions.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Seeded","options":["Seeded","Unseeded"]},{"key":"x","label":"Seed X (%)","type":"range","default":50,"min":0,"max":100,"step":1,"when":{"key":"variant","values":["Seeded"]}},{"key":"y","label":"Seed Y (%)","type":"range","default":50,"min":0,"max":100,"step":1,"when":{"key":"variant","values":["Seeded"]}},{"key":"tolerance","label":"Intensity tolerance","type":"range","default":25,"min":1,"max":90,"step":1}],"workingLimit":512},
    {"id":"split","name":"Split & merge","formula":"split if σ(region) > T, merge neighboring similar regions","description":"Segment by quadtree splitting and adjacent region merging.","params":[{"key":"tolerance","label":"Homogeneity","type":"range","default":22,"min":3,"max":65,"step":1},{"key":"minimum","label":"Minimum block","type":"range","default":12,"min":4,"max":48,"step":1}],"workingLimit":640},
    {"id":"kmeans","name":"K-means clustering","formula":"minimize Σᵢ ‖xᵢ − μlabel(i)‖²","description":"Segment by color, optionally including spatial position.","params":[{"key":"clusters","label":"Clusters","type":"range","default":4,"min":2,"max":10,"step":1},{"key":"spatial","label":"Spatial weight","type":"range","default":0,"min":0,"max":2,"step":0.1}],"workingLimit":800},
    {"id":"watershed","name":"Watershed","formula":"regions grow from markers to intensity ridges","description":"Use distance-transform markers to separate touching foreground objects.","params":[{"key":"ratio","label":"Foreground distance","type":"range","default":0.4,"min":0.1,"max":0.9,"step":0.05},{"key":"foreground","label":"Foreground","type":"select","default":"Dark","options":["Dark","Light"]}],"workingLimit":1000},
    {"id":"morphology","name":"Binary morphology","formula":"opening = dilate(erode(f, K), K)","description":"Apply a structuring element to a thresholded binary image.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Opening","options":["Erosion","Dilation","Opening","Closing","Gradient","Top hat","Black hat","Hit or miss"]},{"key":"threshold","label":"Threshold","type":"range","default":128,"min":0,"max":255,"step":1},{"key":"size","label":"Kernel size","type":"range","default":5,"min":3,"max":31,"step":2},{"key":"shape","label":"Element","type":"select","default":"Ellipse","options":["Ellipse","Rectangle","Cross"]},{"key":"iterations","label":"Iterations","type":"range","default":1,"min":1,"max":4,"step":1}]},
    {"id":"components","name":"Connected components","formula":"label = connected foreground component","description":"Label binary objects and optionally draw bounding boxes.","params":[{"key":"threshold","label":"Threshold","type":"range","default":128,"min":0,"max":255,"step":1},{"key":"connectivity","label":"Connectivity","type":"select","default":"8","options":["4","8"]},{"key":"area","label":"Minimum area (%)","type":"range","default":0.15,"min":0,"max":10,"step":0.05}],"workingLimit":1400},
    {"id":"semantic","name":"Semantic segmentation","formula":"label(x,y) = argmax P(class | x,y)","description":"Use PP-HumanSeg to separate people from the background.","params":[{"key":"variant","label":"Display","type":"select","default":"Overlay","options":["Overlay","Mask","Foreground only"]}]}
  ] },
  { "id": "coding", "name": "Coding & compression", "icon": "archive", "methods": [
    {"id":"compression","name":"JPEG / PNG","formula":"ratio = raw bytes / encoded bytes","description":"Encode and decode with a real codec. Inspect file size, ratio and PSNR.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"JPEG","options":["JPEG","PNG","WebP"]},{"key":"quality","label":"Lossy quality","type":"range","default":25,"min":1,"max":100,"step":1,"when":{"key":"variant","values":["JPEG","WebP"]}}]},
    {"id":"lossless","name":"Lossless coding","formula":"entropy = −Σ pᵢ log₂ pᵢ","description":"Compare exact round trips with Huffman coding, RLE, quadtree or DPCM.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Huffman","options":["Huffman","RLE","Binary RLE","Binary quadtree","DPCM"]},{"key":"threshold","label":"Threshold","type":"range","default":128,"min":0,"max":255,"step":1,"when":{"key":"variant","values":["Binary RLE","Binary quadtree"]}}],"workingLimit":768},
    {"id":"fractal","name":"Fractal compression","formula":"range ≈ contrast × downsample(domain) + offset","description":"Encode grayscale blocks as affine maps of larger blocks, then decode iteratively.","params":[{"key":"size","label":"Range block","type":"range","default":8,"min":4,"max":16,"step":4},{"key":"iterations","label":"Decode iterations","type":"range","default":6,"min":1,"max":12,"step":1}],"workingLimit":192},
    {"id":"watermark","name":"Watermark","formula":"g = (1 − α)f + α × mark","description":"Blend a text watermark into the corner.","params":[{"key":"message","label":"Text","type":"text","default":"CITRA STUDIO","maxLength":96},{"key":"opacity","label":"Opacity","type":"range","default":0.55,"min":0.1,"max":1,"step":0.05}]},
    {"id":"lsb","name":"LSB steganography","formula":"B′ = (B & 254) | message_bit","description":"Write or read UTF-8 in blue-channel bits. Export as PNG to preserve the message.","params":[{"key":"variant","label":"Algorithm","type":"select","default":"Embed","options":["Embed","Read"]},{"key":"message","label":"Text","type":"text","default":"Citra Studio","maxLength":96,"when":{"key":"variant","values":["Embed"]}}]}
  ] }
]
